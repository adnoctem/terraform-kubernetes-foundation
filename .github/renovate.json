{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "terraform"
      ],
      "groupName": "Terraform providers"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^variables\\.tf$/"
      ],
      "matchStrings": [
        "# renovate: datasource=helm depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\s+chart_version\\s*=\\s*optional\\(string, \"(?<currentValue>[^\"]+)\"\\)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^variables\\.tf$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\s+chart_version\\s*=\\s*optional\\(string, \"(?<currentValue>[^\"]+)\"\\)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
